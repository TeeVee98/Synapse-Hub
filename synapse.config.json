{
  "$schema": "https://raw.githubusercontent.com/TeeVee98/Synapse-Hub/main/docs/schemas/synapse.config.schema.json",
  "version": "4.8.3",
  "circuit_breaker": {
    "max_fix_attempts": 2,
    "rollback_on_trip": true
  },
  "mutation": {
    "min_score": 80.0,
    "small_diff_threshold": 5,
    "polyglot_ast_enabled": true
  },
  "planning": {
    "critical_paths": [
      "auth",
      "security",
      "schema",
      "database",
      "core",
      "runner",
      "base_page",
      "migration",
      "payment",
      "middleware"
    ],
    "adr_high_impact_only": true,
    "default_mode": "super"
  },
  "model_router": {
    "models": {
      "flash_lite": "gemini-3.8-flash",
      "flash": "gemini-4-hydrogen",
      "pro": "gemini-4-neon"
    }
  },
  "telemetry": {
    "min_kv_cache_hit_rate_pct": 85.0,
    "alert_on_cache_miss": true
  },
  "quality_gates": {
    "mutation_min_score": 80.0,
    "gates": {
      "gate_1_bom_check": true,
      "gate_2_path_portability": true,
      "gate_3_clean_pom": true,
      "gate_4_ai_docs_lint": true,
      "gate_5_cleanup_blacklist": true,
      "gate_6_credential_security": true,
      "gate_7_infer_linter": true,
      "gate_8_micro_mutator": true,
      "gate_9_skill_collision": true,
      "gate_10_performance_sla": true,
      "gate_11_token_reduction": true
    }
  },
  "performance": {
    "sla": {
      "p95_ms": 500.0,
      "p99_ms": 1000.0,
      "max_error_rate_pct": 1.0
    },
    "auto_benchmark_fallback": true
  },
  "security": {
    "allowed_pentest_hosts": [
      "localhost",
      "127.0.0.1",
      "staging-api.synapse.local"
    ],
    "require_consent": true
  },
  "infer_linter": {
    "enabled": true,
    "strict": true,
    "format": "text",
    "exclude_paths": [
      ".git",
      ".synapse",
      "node_modules",
      "templates"
    ],
    "disabled_rules": []
  }
}
