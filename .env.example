# ==============================================================================
# Synapse Hub Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and customize according to your local environment.

# 1. Target Web Application Under Test (Used by 'doctor' and live explorers)
BASE_URL=http://localhost:3000

# 2. Target Project Directory (When running in Hub-Spoke multi-root workspace mode)
# TARGET_PROJECT_DIR=../my-target-project

# 3. Air-Gapped / Offline Execution (1 = Disable all external network calls)
SYNAPSE_OFFLINE=0

# 4. Insecure TLS Bypass (0 = Strict TLS verification, 1 = Allow self-signed certificates)
SYNAPSE_INSECURE_SSL=0
